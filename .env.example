# Needs an LLM. Ships with an Anthropic Claude adapter:
#   - Install the `claude` CLI on PATH, or
#   - Set ANTHROPIC_API_KEY in a local .env (never commit the value).
# All model calls go through deckwright/llm.py.
# Force the Anthropic Messages API (billed credits): DECKWRIGHT_LLM=api
# When the CLI is on PATH, ./run.sh unsets ANTHROPIC_API_KEY so calls use the CLI.

# Bind localhost by default (./run.sh also defaults here). Use 0.0.0.0 only if
# you intentionally want other devices on your network to reach the app.
HOST=127.0.0.1
PORT=8000

# Opt in to git pull on launch (off by default for local clones):
# DECKWRIGHT_PULL_ON_LAUNCH=1
